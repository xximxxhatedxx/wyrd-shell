[Unit]
Description=Wyrd Audio Daemon
PartOf=graphical-session.target wyrd-shell.service
After=graphical-session.target pipewire.service pulseaudio.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/wyrd-audio
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target default.target